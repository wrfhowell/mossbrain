{
  "name": "stone wizard",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm -w api run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w api run build && npm -w web run build",
    "typecheck": "npm -w api run typecheck && npm -w web run typecheck",
    "db:generate": "npm -w api run db:generate",
    "db:migrate": "npm -w api run db:migrate"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "three": "^0.184.0"
  }
}
